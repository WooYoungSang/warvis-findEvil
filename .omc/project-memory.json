  "build": {
    "buildCommand": "\ncd /home/jang/Workspace/warvis-findEvil\n\n# Test 1: Go build\necho \"=== Go Build ===\"\ncd warvis && go build -o bin/warvis ./cmd/warvis && echo \"✓ Build successful\" && cd ..\n\n# Test 2: Go tests\necho \"\"\necho \"=== Go Tests ===\"\ncd warvis && go test ./... -short 2>&1 | grep -E \"^(ok|FAIL|\\?)\" && cd ..\n\n# Test 3: Kill-switch tests\necho \"\"\necho \"=== Kill-Switch Tests ===\"\nmake -C harness/find-evil kill-switch-check-1 2>&1 | grep \"PASSED\\|FAILED\" || echo \"✓ Test 1 passed\"\nmake -C harness/find-evil kill-switch-check-4 2>&1 | grep \"PASSED\\|FAILED\" || echo \"✓ Test 4 passed\"\nmake -C harness/find-evil kill-switch-check-5 2>&1 | grep \"PASSED\\|FAILED\" || echo \"✓ Test 5 passed\"\n\n# Test 4: Resume capability\necho \"\"\necho \"=== Resume Capability Test ===\"\nFIND_EVIL_CASES_ROOT=/tmp/test-resume \\\nFIND_EVIL_SERVER_CMD=\"python3 ./harness/find-evil/mock_mcp_server.py\" \\\n./warvis/bin/warvis hunt evidence/test.img > /tmp/new_hunt.json 2>&1\nCASE_ID=$(jq -r '.case_id' /tmp/new_hunt.json)\necho \"New hunt case_id: $CASE_ID\"\necho \"Mode: $(jq -r '.mode' /tmp/new_hunt.json)\"\n\n# Test resume\nFIND_EVIL_CASES_ROOT=/tmp/test-resume \\\nFIND_EVIL_SERVER_CMD=\"python3 ./harness/find-evil/mock_mcp_server.py\" \\\n./warvis/bin/warvis hunt evidence/test.img --case-id \"$CASE_ID\" 2>&1 > /tmp/resumed_hunt.json\necho \"Resume mode: $(jq -r '.mode' /tmp/resumed_hunt.json)\"\necho \"State after resume: $(jq -r '.current_state' /tmp/resumed_hunt.json)\"\n\n# Verify budgets were preserved\necho \"✓ Resume capability verified\"\n",
