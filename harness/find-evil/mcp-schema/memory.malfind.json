{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "memory.malfind",
  "description": "Detect suspicious memory regions (injected code, unlinked modules) from memory dump using Volatility3. Returns findings with YARA hits and severity classification.",
  "type": "object",
  "properties": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "UUID v4 case identifier from case.open."
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional process ID. If omitted, scans all processes in memory image."
        }
      },
      "required": ["case_id"],
      "additionalProperties": false,
      "description": "Case identifier required; PID optional (default: all processes)."
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Echo of input case_id."
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 0,
                "description": "Process ID containing suspicious region."
              },
              "vad_start": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]+$",
                "description": "Hex start address of suspicious VAD region."
              },
              "vad_end": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]+$",
                "description": "Hex end address of suspicious VAD region."
              },
              "protection": {
                "type": "string",
                "description": "Memory protection flags (e.g., PAGE_EXECUTE_READWRITE, PAGE_NOACCESS)."
              },
              "yara_hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule": {
                      "type": "string",
                      "description": "Name of matched YARA rule."
                    },
                    "offset": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]+$",
                      "description": "Hex offset within VAD region where match occurred."
                    }
                  },
                  "required": ["rule", "offset"],
                  "additionalProperties": false
                },
                "description": "Array of YARA rule matches within this region."
              },
              "severity": {
                "type": "string",
                "enum": ["info", "low", "medium", "high", "critical"],
                "description": "Severity classification of suspicious region."
              }
            },
            "required": ["pid", "vad_start", "vad_end", "protection", "yara_hits", "severity"],
            "additionalProperties": false
          },
          "description": "Array of suspicious memory regions detected."
        },
        "scanned_pids": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of processes scanned."
        },
        "tool_used": {
          "type": "string",
          "enum": ["volatility3"],
          "description": "Tool that performed the memory analysis."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of analysis completion."
        }
      },
      "required": ["case_id", "findings", "scanned_pids", "tool_used", "generated_at"],
      "additionalProperties": false,
      "description": "Malfind results with VAD regions, YARA matches, and severity classification."
    }
  },
  "required": ["inputSchema", "outputSchema"],
  "additionalProperties": false,
  "x-mcp-capability": {
    "name": "memory.malfind",
    "version": "0.1.0",
    "description": "Detect injected/suspicious memory regions via Volatility3 malfind plugin.",
    "side_effects": [
      "subprocess:volatility3",
      "fs:read:sandbox"
    ],
    "host": "sift_docker_proxy",
    "subprocess": ["volatility3"],
    "constraints": [
      "case_id must be valid UUID v4 from case.open",
      "pid pattern enforces integer >= 0; if specified, must exist in process tree",
      "Only volatility3 subprocess permitted",
      "vad_start and vad_end must be hex addresses in 0x... format",
      "yara_hits offset must be hex address relative to VAD region start",
      "severity must use only whitelisted enum values",
      "All findings must include yara_hits (may be empty if no YARA match)"
    ]
  }
}
