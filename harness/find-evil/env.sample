# ITEM-212 FIND EVIL — env vars
# Copy to .env (gitignored). NEVER commit real values.

# --- Devpost / submission metadata ---
DEVPOST_SUBMISSION_ID=
DEVPOST_TEAM_NAME=

# --- MCP server transport ---
# stdio | http | both
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=7912

# --- Sandbox / case storage ---
# All case files MUST live under this root. Server refuses paths outside.
CASES_ROOT=/cases
REPORT_SUBDIR=report

# --- SIFT toolchain (allow-list) ---
# Absolute paths only. Empty = tool disabled.
SIFT_VOLATILITY_BIN=
SIFT_PLASO_LOG2TIMELINE_BIN=
SIFT_PLASO_PSORT_BIN=
SIFT_ZEEK_BIN=
SIFT_YARA_BIN=
SIFT_SURICATA_BIN=

# --- LLM backend (CPU-only, NFR: GPU=0) ---
# Format: <provider>:<model>
LLM_BACKEND=ollama:gemma4:e4b
OLLAMA_HOST=http://infra-data-prod-ollama:11434

# --- SENTINEL-lite stretch tool (optional) ---
SENTINEL_LITE_BIN=
SENTINEL_LITE_ENABLED=false

# --- Observability ---
LOG_DIR=harness/find-evil/logs
LOG_LEVEL=info
TRACE_FORMAT=jsonl

# --- Discord webhook (mission-control owned, leave empty) ---
DISCORD_WEBHOOK_URL=

# --- Limits ---
TOOL_TIMEOUT_SECONDS=120
MAX_REPORT_BYTES=10485760
