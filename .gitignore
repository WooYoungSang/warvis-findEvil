.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
harness/find-evil/logs/
.env
.env.*
!env.sample

# OMC / devos runtime cache (machine-local, not source-of-truth)
.omc/state/
.omc/sessions/
.omc/project-memory.json
warvis/.omc/state/
warvis/.omc/sessions/
warvis/.omc/project-memory.json
# But keep plans (canonical UoW specs) and notepad
!.omc/plans/
!warvis/.omc/plans/

# Large DFIR fixture binaries — track only manifest + readme + evidence symlink
# (the symlink resolves to /mnt/disk1; files inside it are not tracked)
repos/find-evil-fixtures/cases/sans-starter/*
!repos/find-evil-fixtures/cases/sans-starter/MANIFEST.md
!repos/find-evil-fixtures/cases/sans-starter/README.md
!repos/find-evil-fixtures/cases/sans-starter/evidence
!repos/find-evil-fixtures/cases/sans-starter/.gitkeep
!repos/find-evil-fixtures/cases/sans-starter/smoke-*.txt
!repos/find-evil-fixtures/cases/sans-starter/real-hunt-trace/
!repos/find-evil-fixtures/cases/sans-starter/real-hunt-trace/**
!repos/find-evil-fixtures/cases/sans-starter/real-hunt-trace-26b/
!repos/find-evil-fixtures/cases/sans-starter/real-hunt-trace-26b/**
!repos/find-evil-fixtures/cases/sans-starter/comprehensive-mock-trace/
!repos/find-evil-fixtures/cases/sans-starter/comprehensive-mock-trace/**
